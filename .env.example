# Supabase local defaults from `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Android Emulator reaches the host machine through 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# AI Tutor is server-only and remains OFF until an approved policy and provider
# are configured. Never expose these values through NEXT_PUBLIC_* or EXPO_PUBLIC_*.
AI_TUTOR_ENABLED=false
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_ID=
AI_PROVIDER_MODEL=
# Optional lower test timeout; production default and maximum are 8000 ms.
AI_PROVIDER_TIMEOUT_MS=8000

# AI study assistant (server-only; never prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_).
# Stays off unless every value is set and AI_MODEL is on the server allowlist.
AI_ENABLED=false
# anthropic (Messages API) or openai (any OpenAI-compatible Chat Completions gateway).
AI_PROVIDER=anthropic
# anthropic: claude-sonnet-5 | claude-haiku-4-5-20251001 | claude-opus-5-5; openai: gemini-3.8-flash
AI_MODEL=
AI_API_KEY=
# Optional: max answer length in tokens (256–8192, default 4096).
AI_MAX_OUTPUT_TOKENS=
# Operator-only endpoint. anthropic defaults to https://api.anthropic.com;
# openai has no default and must include the version path, e.g. https://api.vnaipro.app/v1
AI_API_BASE_URL=
# Optional, openai provider only: none | minimal | low | medium | high (default minimal).
# Lower is much faster (about 4 s instead of 10 s to the first word on Gemini flash).
AI_REASONING_EFFORT=

# News sync (server-only). The hourly job (.github/workflows/news-sync.yml) calls
# /api/news/sync with this secret header; use at least 24 random characters.
NEWS_CRON_SECRET=
# Lets the scheduled job write posts without a user session. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Page access token for the school's Facebook page (Graph API, pages_read_engagement).
# Leave empty to skip Facebook; website feeds keep working.
FACEBOOK_PAGE_ACCESS_TOKEN=
