{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sao-do-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // next/image optimisation through Cloudflare Images
  "images": { "binding": "IMAGES" },
  // API rate limits counted at the edge (src/lib/rate-limit.ts keeps the same numbers).
  "ratelimits": [
    { "name": "API_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "API_USER_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
