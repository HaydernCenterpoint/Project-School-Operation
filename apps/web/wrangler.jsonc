{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sao-do-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "images": { "binding": "IMAGES" },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://marcus-boc-telescope-composition.trycloudflare.com",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0",
    "SUPABASE_URL": "https://marcus-boc-telescope-composition.trycloudflare.com",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0",
    "AI_ENABLED": "true",
    "AI_PROVIDER": "openai",
    "AI_API_BASE_URL": "https://api.vnaipro.app/v1",
    "AI_API_KEY": "sk-zscrq3IrpQSJhYyvORL0dXxbm4sqXZfkHwMpK8CbHRFU1VcQ",
    "AI_MODEL": "gpt-6-luna",
    "AI_REASONING_EFFORT": "medium",
    "AI_MAX_OUTPUT_TOKENS": "4096"
  },
  "ratelimits": [
    { "name": "API_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "API_USER_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
